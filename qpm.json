{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.4.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "BeatSaberTheaterQuest",
    "id": "bstheater",
    "version": "0.1.0",
    "url": null,
    "additionalData": {
      "overrideSoName": "libbstheater.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "clean": [
        "pwsh ./scripts/build.ps1 -clean"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1",
        "qpm qmod zip --skip_build --offline"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1 $0:?"
      ],
      "test": [
        "pwsh ./scripts/test.ps1"
      ],
      "logcat": [
        "pwsh ./scripts/start-logging.ps1"
      ],
      "tomb": [
        "pwsh ./scripts/pull-tombstone.ps1"
      ],
      "build-java": [
        "pwsh ./scripts/build-java.ps1"
      ]
    },
    "ndk": "^27.3.13750724",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [
      "./LICENSE",
      "./THIRD_PARTY_NOTICES.md",
      "./third_party/desugar-ASSEMBLY_EXCEPTION.txt",
      "./third_party/desugar-LICENSE.txt",
      "./third_party/jsoup-MIT.txt",
      "./third_party/jsr305-Apache-2.0.txt",
      "./third_party/protobuf-BSD.txt",
      "./third_party/Rhino-MPL-2.0.txt",
      "./third_party/quickjs-MIT.txt",
      "./third_party/ejs-Unlicense.txt",
      "./third_party/ejs-dependencies.txt",
      "./third_party/songcore-icon-MIT.txt"
    ],
    "qmodOutput": "./BeatSaberTheaterQuest-0.1.0.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "4008.*",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^2.0.3",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.4",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "songcore",
      "versionRange": "^1.1.26",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.55",
      "additionalData": {}
    }
  ]
}






